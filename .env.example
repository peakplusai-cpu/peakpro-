# PeakPro+ — copy to .env.local. Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — create a NEW project (do not reuse PeakPlus)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-peakpro-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth URL Configuration:
#   Site URL:        https://your-peakpro-domain.com
#   Redirect URLs:   https://your-peakpro-domain.com/auth/callback
#                    http://localhost:3000/auth/callback

# -----------------------------------------------------------------------------
# Creem — create a NEW product + webhook for this app
# -----------------------------------------------------------------------------
CREEM_API_KEY=creem_your-api-key
CREEM_WEBHOOK_SECRET=whsec_your-webhook-secret
CREEM_PRODUCT_ID=prod_your-30-day-subscription-id
CREEM_TEST_MODE=true

# Webhook URL (after Vercel domain is live):
#   https://your-peakpro-domain.com/api/webhooks/creem

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string

# GET /api/cron/fetch-market-data?cron_secret=...
# Every 3 hours. Vercel Hobby: use cron-job.org
# GET /api/cron/fetch-news?cron_secret=...
# Every 15 minutes. News only — does not re-scrape the tape.

# -----------------------------------------------------------------------------
# Optional — AI weekly brief + Desk Advisor chat (server-side only)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
